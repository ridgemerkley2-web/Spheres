+fn immutable_read<'a, T: Clone>(reuse: bool, slot: &'a OnceCell<T>,
+    read: impl FnOnce() -> T) -> Cow<'a, T> {
+    if reuse { Cow::Borrowed(slot.get_or_init(read)) } else { Cow::Owned(read()) }
