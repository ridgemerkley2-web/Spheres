+      "claims": [
+        {
+          "id": "za_da_fedex_informed_maimane_resignation_decision_20191024",
+          "text": "The statement issued on \"24 Oct 2019\" says \"On Wednesday, the Democratic Alliance (DA) Federal Executive (FedEx) was informed of the personal decision of its Federal Leader, Mmusi Maimane, and Federal Chairperson, Athol Trollip to resign from their positions\".",
+          "attested_on": "2019-10-24",
+          "locator": {
+            "section": "First paragraph"
