const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),zlib=require('node:zlib'),assert=require('node:assert/strict'),cp=require('node:child_process');
const base=path.resolve(__dirname,'..'),ev=__dirname,repo=path.join(base,'s22-economic-ranking'),out=path.join(repo,'docs/campaign-certification/S22/qualification-pair-02'),pair=path.join(ev,'s22-qualification-pair-02'),pres=path.join(ev,'s22-pair02-preservation-01');
const read=p=>JSON.parse(fs.readFileSync(p,'utf8')),sha=b=>crypto.createHash('sha256').update(b).digest('hex'),norm=p=>path.resolve(p).toLowerCase(),CHUNK=90*1024*1024;
const frozen=read(path.join(pres,'frozen/s22-qualification-pair-02-manifest.json')),restore=read(path.join(pres,'restore-manifest.json')),inventory=read(path.join(pres,'inventory-before.json'));
const verdict=read(path.join(pres,'frozen/runner-verdict.json'));assert.equal(verdict.passed,true);assert.equal(verdict.cells.length,18);assert.equal(verdict.cells.filter(c=>c.passed).length,18);
fs.mkdirSync(out,{recursive:true});fs.mkdirSync(path.join(out,'objects'),{recursive:true});const records=[],payloads=new Map(),seen=new Set(),removed=new Map(restore.files.map(r=>[norm(r.original_path),r]));
function writeOnce(p,b){fs.mkdirSync(path.dirname(p),{recursive:true});if(fs.existsSync(p))assert(fs.readFileSync(p).equals(b),'Existing archive bytes differ '+p);else fs.writeFileSync(p,b,{flag:'wx'});}
function encodedPayload(b){const id=sha(b);if(payloads.has(id))return id;const chunks=[];for(let offset=0,i=0;offset<b.length||i===0;offset+=CHUNK,i++){const part=b.subarray(offset,offset+CHUNK),name=`objects/${id}.${String(i).padStart(3,'0')}.bin`;writeOnce(path.join(out,name),part);chunks.push({path:name,bytes:part.length,sha256:sha(part)});}payloads.set(id,{sha256:id,bytes:b.length,chunks});return id;}
function capture(source,options={}){const original=options.original||source,key=norm(original);if(seen.has(key))return;let raw=fs.readFileSync(source);const digest=sha(raw);if(options.expected){assert.equal(raw.length,options.expected.bytes,source);assert.equal(digest,options.expected.sha256,source);}let encoding='identity',encoded=raw;if(raw.length>1024*1024&&/\.(json|jsonl|log|csv|html|js|cjs)$/i.test(source)){encoded=zlib.gzipSync(raw,{level:6});assert(zlib.gunzipSync(encoded).equals(raw));encoding='gzip';}const st=fs.statSync(source);records.push({original_path:original,captured_from:source,bytes:raw.length,sha256:digest,original_last_write_utc:options.last_write_utc||st.mtime.toISOString(),encoding,payload:encodedPayload(encoded),scope:options.scope||'Original artifact bytes'});seen.add(key);}
for(const row of inventory.files){const r=removed.get(norm(row.path));if(r){assert(!fs.existsSync(row.path),'Removed path unexpectedly recreated');const gzip=fs.readFileSync(r.restore_gzip);assert.equal(gzip.length,r.gzip_bytes);assert.equal(sha(gzip),r.gzip_sha256);const raw=zlib.gunzipSync(gzip);assert.equal(raw.length,r.bytes);assert.equal(sha(raw),r.sha256);let payload=encodedPayload(gzip);records.push({original_path:r.original_path,bytes:r.bytes,sha256:r.sha256,original_last_write_utc:r.last_write_utc,original_creation_utc:r.creation_utc,encoding:'gzip',payload,captured_from:r.restore_gzip,scope:'Recoverably removed approved raw copy; exact gzip roundtrip verified before removal and again while archiving'});seen.add(norm(row.path));}else capture(row.path,{last_write_utc:row.last_write_utc});}
assert.equal(records.length,636);
function walk(dir,fn){for(const ent of fs.readdirSync(dir,{withFileTypes:true})){const p=path.join(dir,ent.name);if(ent.isDirectory())walk(p,fn);else fn(p);}}
walk(path.join(ev,'s22-qualification-pair-02-runner'),p=>capture(p));
const savedFrozen=read(path.join(pres,'frozen-capture-manifest.json'));for(const r of savedFrozen.files)capture(r.capture,{original:r.source,expected:r,scope:'Exact final captured bytes; registry snapshot belongs to pair02 completion'});
for(const name of ['s22-qualification-pair-02-console.log','s22-pair02-preflight-fetch.log','s22-run-declared-pair.cjs','s22-run-declared-pair.md','s22-run-declared-pair-syntax-check.json','s22-pair02-preserve-raw.ps1','s22-run-declared-pair-02-notes.md','s22-pair02-independent-verdict.json','s22-pair02-independent-verification.log'])capture(path.join(ev,name));
const inputArchives={
 'fc094d539a52273a7861f942bbd04fb6ddfa42effacbf21edf1632a5fab24f27':'docs/campaign-certification/S22/runtime-preflight/inputs/s22-adopted-input.json.gz',
 'e786ffb67a26c6ae28bd917d5d8dc26f857e441dd6a58d60adc1a1107937ca11':'docs/campaign-certification/S22/stock-fix-progress/inputs/s22-2015-01-01.json.gz',
 '67aadca2f55280abc0e4ad97944a654ec7d173ffb65cb7d71dd59090e10503cb':'docs/campaign-certification/S22/late-input-progress/inputs/s22-2035-11-30.json.gz',
 '1af599ec1568a5b2148354de25cb800780d8ce69d352664f0a944242fac5ca8c':'docs/campaign-certification/S19/integration/flight-closeout-evidence/recorded-flight-qualified.json.gz'};
const repoBytes=p=>fs.existsSync(path.join(repo,p))?fs.readFileSync(path.join(repo,p)):cp.execFileSync('git',['show','HEAD:'+p],{cwd:repo,maxBuffer:256*1024*1024});
function frozenRef(r){if(!r||typeof r!=='object')return;if(r.path&&r.bytes!==undefined&&r.sha256){if(seen.has(norm(r.path)))return;if(/\.exe$/i.test(r.path)){records.push({original_path:r.path,bytes:r.bytes,sha256:r.sha256,encoding:'external-binary',scope:'Immutable binary external reference from frozen manifest; executable not copied into Git'});seen.add(norm(r.path));return;}if(inputArchives[r.sha256]){const p=inputArchives[r.sha256],gzip=repoBytes(p),raw=zlib.gunzipSync(gzip);assert.equal(raw.length,r.bytes);assert.equal(sha(raw),r.sha256);records.push({original_path:r.path,bytes:r.bytes,sha256:r.sha256,encoding:'repository-gzip',repository_path:p,compressed_bytes:gzip.length,compressed_sha256:sha(gzip),scope:'Existing immutable canonical input archive; uncompressed bytes independently verified'});seen.add(norm(r.path));return;}capture(r.path,{expected:r,scope:'Exact frozen prerequisite/source artifact'});return;}for(const value of Object.values(r))frozenRef(value);}
frozenRef(frozen);walk(pres,p=>capture(p));capture(__filename);

const manifest={schema:'spheres-s22-lossless-evidence-archive/v1',attempt_id:frozen.attempt_id,candidate_revision:frozen.candidate_revision,archived_utc:new Date().toISOString(),qualification_passed:true,attempt_status:'passed',cells:18,passed_cells:18,failed_cells:[],scope:'Complete pair02 output and final runner records, frozen prerequisites and exact restore mappings. The original and independent verifiers recorded passing18of18; no cell rerun or substitution. This archive is byte preservation, not another execution. Binary bodies are external hash references. Restore raw paths before invoking the original verifier.',original_pair_files:636,original_pair_bytes:inventory.files.reduce((n,r)=>n+r.bytes,0),approved_recoverably_removed_files:42,approved_reclaimed_bytes:restore.files.reduce((n,r)=>n+r.bytes,0),chunk_limit_bytes:CHUNK,files:records.sort((a,b)=>a.original_path.localeCompare(b.original_path)),payloads:[...payloads.values()].sort((a,b)=>a.sha256.localeCompare(b.sha256))};
writeOnce(path.join(out,'.gitattributes'),Buffer.from('* -text\nobjects/** -diff\n'));
fs.writeFileSync(path.join(out,'manifest.json'),JSON.stringify(manifest,null,2)+'\n');
fs.mkdirSync(path.join(out,'records'),{recursive:true});for(const [src,name] of [['runner-verdict.json','verdict.json'],['runner-run-summary.json','run-summary.json'],['s22-qualification-pair-02-manifest.json','frozen-manifest.json']])writeOnce(path.join(out,'records',name),fs.readFileSync(path.join(pres,'frozen',src)));
writeOnce(path.join(out,'records/independent-verdict.json'),fs.readFileSync(path.join(ev,'s22-pair02-independent-verdict.json')));
console.log(JSON.stringify({files:records.length,payloads:payloads.size,chunks:[...payloads.values()].reduce((n,p)=>n+p.chunks.length,0),stored_bytes:[...payloads.values()].reduce((n,p)=>n+p.bytes,0),original_pair_files:636,original_pair_bytes:manifest.original_pair_bytes}));
