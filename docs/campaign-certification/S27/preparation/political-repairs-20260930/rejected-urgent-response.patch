diff --git a/spheres-sim/tests/political_responses.rs b/spheres-sim/tests/political_responses.rs
new file mode 100644
index 00000000..d6d844ce
--- /dev/null
+++ b/spheres-sim/tests/political_responses.rs
@@ -0,0 +1,61 @@
+use spheres_sim::{government::{self, Pillar}, init::world_1990,
+    world::{GameRules, NationId, WorldState}, Command};
+
+fn world(daily: bool) -> WorldState {
+    let id = NationId::Sudan;
+    let mut w = world_1990(GameRules { seed: 0, ideology_blocs: true,
+        ideology_takeover: true, daily_simulation: daily, ..GameRules::default() });
+    // Isolate this actor's dispatch and single draw; this is a synthetic unit
+    // fixture, not a campaign cohort or a historical outcome claim.
+    for n in &mut w.nations { n.alive = n.id == id; }
+    w.nation_mut(id).political_capital = 30.0;
+    let g = w.governments.states.iter_mut().find(|g| g.nation == id).unwrap();
+    g.coup_pressure = 0.4;
+    for (p, loyalty) in &mut g.pillars {
+        *loyalty = if *p == Pillar::Army { 0.20 } else { 0.90 };
+    }
+    w.rng.state = 0;
+    assert_eq!(government::ai_lever(&w,id), Some(Command::ConveneRoundTable { nation:id }));
+    w
+}
+
+#[test]
+fn selected_live_threat_response_keeps_one_draw_and_pays_without_waiting_for_a_routine_roll() {
+    let id = NationId::Sudan;
+    for daily in [false, true] {
+        let mut w = world(daily);
+        let mut expected_rng = w.rng.clone();
+        assert!(!expected_rng.chance(spheres_sim::clock::chance(&w, 0.02)));
+        let mut restored = spheres_sim::load(&spheres_sim::save(&w)).unwrap();
+        spheres_sim::stratagems::ai_stratagems(&mut w);
+        spheres_sim::stratagems::ai_stratagems(&mut restored);
+        assert!(government::is_electoral(&w,id), "the selected crisis response was left waiting");
+        assert_eq!(w.nation(id).political_capital, 0.0);
+        assert_eq!(w.rng, expected_rng, "exactly the existing one decision draw");
+        assert_eq!(spheres_sim::save(&w), spheres_sim::save(&restored));
+        let g = government::state(&w,id).unwrap();
+        assert!(g.awaiting_first_election);
+        assert_eq!(g.next_election, (1990,7));
+        assert_eq!(w.headlines.iter().filter(|h| h.contains("convenes a round table")).count(),1);
+    }
+}
+
+#[test]
+fn absent_recovered_unaffordable_or_closed_threat_keeps_ordinary_dispatch() {
+    let id = NationId::Sudan;
+    for control in 0..5 {
+        let mut w = world(false);
+        match control {
+            0 => w.governments.states.iter_mut().find(|g| g.nation == id).unwrap().coup_pressure=0.0,
+            1 => { for (p,v) in &mut w.governments.states.iter_mut().find(|g| g.nation == id).unwrap().pillars {
+                if *p==Pillar::Army { *v=0.35; }
+            } },
+            2 => w.nation_mut(id).political_capital=29.0,
+            3 => w.governments.states.iter_mut().find(|g| g.nation == id).unwrap().movements.clear(),
+            _ => w.rules.ideology_blocs=false,
+        }
+        let saved=spheres_sim::save(&w);
+        spheres_sim::stratagems::ai_stratagems(&mut w);
+        assert_eq!(spheres_sim::save(&w),saved,"control {control}");
+    }
+}
