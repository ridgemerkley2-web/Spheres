+#[test]
+fn s16_legacy_raid_losses_preserve_parked_fighters_and_their_loss_carry() {
+    for missiles in [0, 100] {
+        let mut w = fixture();
+        // Authored certified fighter hardware joins an existing bomber fleet.
+        // Both remain outside squadron enrollment to exercise legacy raids.
+        w.nation_mut(USA).equipment.as_mut().unwrap().learned
+            .extend(equipment::RESEARCH.iter().map(|r| r.id.into()));
+        let spec = equipment::default_spec("air_fighter");
+        let preview = equipment::design_preview(&w, USA, &spec);
+        assert!(preview.valid, "{:?}", preview.blockers);
+        let day = crate::clock::absolute_day(&w);
+        w.nation_mut(USA).equipment.as_mut().unwrap().revisions.insert(
+            "parked-fighter".into(),
+            equipment::DesignRevision {
+                id: "parked-fighter".into(),
+                name: "Authored parked fighter".into(),
+                specification_key: equipment::specification_key(&spec),
+                spec,
+                profile: preview.profile.unwrap(),
+                created_day: day,
+                certified_day: Some(day),
+            },
+        );
+        arsenal::deliver_design(w.nation_mut(USA), "parked-fighter", 1000, 0.0).unwrap();
+        w.nation_mut(USA).arsenal.held.iter_mut()
+            .find(|h| h.design_id.as_deref() == Some("parked-fighter")).unwrap()
+            .loss_remainder = 0.999999;
+        assert!(w.nation(USA).aviation.is_none());
+        ammunition_operation_tests::stock(&mut w, 100_000);
+        if missiles > 0 {
+            equipment::seed_test_ammunition(&mut w, USA, "air_missile_short_range", missiles);
+        }
+        let fighter = w.nation(USA).arsenal.held.iter()
+            .find(|h| h.design_id.as_deref() == Some("parked-fighter")).unwrap().clone();
+        let ammo = w.nation(USA).equipment.as_ref().unwrap().ammunition.as_ref().unwrap();
+        let missile_stock = ammo.stocks.get("air_missile_short_range").copied().unwrap_or(0.0);
+        let missile_consumed = ammo.consumed.get("air_missile_short_range").copied().unwrap_or(0.0);
+        let mut snapshot = Snapshot::new(&w);
+        let planned = &snapshot.ammunition[&USA];
+        assert!(planned.families.iter().find(|r| r.family == "air_bomb_unguided").unwrap().used > 0.0);
+        let fighter_stores = planned.families.iter().find(|r| r.family == "air_missile_short_range").unwrap();
+        assert_eq!(fighter_stores.required, 0.0);
+        assert_eq!(fighter_stores.used, 0.0);
+        let bomber_loss = 1000.0 * snapshot.rows[&(400, USA)].deployed
+            / w.nation(USA).mil_strength * 0.4 * 0.5;
+        assert!(bomber_loss >= 1.0, "This must exercise a real whole-aircraft writeoff");
+        snapshot.record_loss(400, USA, 0.4);
+        snapshot.settle(&mut w);
+        let holdings = &w.nation(USA).arsenal.held;
+        let bomber = holdings.iter().find(|h| h.design_id.as_deref() == Some("ammo-model")).unwrap();
+        assert!(bomber.units < 1000.0);
+        near(1000.0 - bomber.units + bomber.loss_remainder, bomber_loss);
+        let parked = holdings.iter().find(|h| h.design_id.as_deref() == Some("parked-fighter")).unwrap();
+        assert_eq!(serde_json::to_value(parked).unwrap(), serde_json::to_value(&fighter).unwrap());
+        let ammo = w.nation(USA).equipment.as_ref().unwrap().ammunition.as_ref().unwrap();
+        assert_eq!(ammo.stocks.get("air_missile_short_range").copied().unwrap_or(0.0), missile_stock);
+        assert_eq!(ammo.consumed.get("air_missile_short_range").copied().unwrap_or(0.0), missile_consumed);
+        let receipt = ammo.last_consumption.as_ref().unwrap();
+        assert_eq!(receipt.day, day);
+        assert!(receipt.used["air_bomb_unguided"] > 0.0);
+        assert_eq!(receipt.used.get("air_missile_short_range").copied().unwrap_or(0.0), 0.0);
+    }
+}
