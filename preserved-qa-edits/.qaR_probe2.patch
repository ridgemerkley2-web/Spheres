+    #[test]
+    #[ignore]
+    fn qa_frontier_both_instruments() {
+        // OLD instrument: default seed, one reading per nation, ceiling 4.0%.
+        // NEW instrument: median of ten worlds per nation (4.0%), plus a pooled
+        // median of all sixty readings against 3.5%.
+        let mature = [
+            NationId::USA, NationId::Japan, NationId::Germany,
+            NationId::France, NationId::UK, NationId::Italy,
+        ];
+        let mut per_nation: Vec<Vec<f64>> = vec![Vec::new(); mature.len()];
+        // old: default seed
+        let mut old: Vec<f64> = Vec::new();
+        {
+            let mut w = world_1990(GameRules::default());
+            let g0: Vec<f64> = mature.iter().map(|id| w.nation(*id).gdp).collect();
+            run_months(&mut w, 12 * 35);
+            for (k, id) in mature.iter().enumerate() {
+                let n = w.nation(*id);
+                if n.alive { old.push(exact::powf(n.gdp / g0[k], 1.0 / 35.0) - 1.0); }
+            }
+        }
+        for seed in 0..10u64 {
+            let mut w = world_1990(GameRules { seed, ..GameRules::default() });
+            let g0: Vec<f64> = mature.iter().map(|id| w.nation(*id).gdp).collect();
+            run_months(&mut w, 12 * 35);
+            for (k, id) in mature.iter().enumerate() {
+                let n = w.nation(*id);
+                if n.alive { per_nation[k].push(exact::powf(n.gdp / g0[k], 1.0 / 35.0) - 1.0); }
+            }
+        }
+        let mut pooled: Vec<f64> = Vec::new();
+        let mut meds: Vec<f64> = Vec::new();
+        for k in 0..mature.len() {
+            let mut xs = per_nation[k].clone();
+            pooled.extend(xs.iter().copied());
+            xs.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            meds.push(median_of_sorted(&xs));
+        }
+        pooled.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        let pm = median_of_sorted(&pooled);
+        let oldmax = old.iter().cloned().fold(f64::MIN, f64::max);
+        let oldmin = old.iter().cloned().fold(f64::MAX, f64::min);
+        let medmax = meds.iter().cloned().fold(f64::MIN, f64::max);
+        let medmin = meds.iter().cloned().fold(f64::MAX, f64::min);
+        println!(
+            "QAFRONT runaway={:.4} OLDmax={:.3} OLDmin={:.3} OLDred={} | MEDmax={:.3} MEDmin={:.3} MEDred={} | POOLED={:.3} POOLEDred={}",
+            crate::world::qa_knob("QA_RUNAWAY", 0.0),
+            oldmax * 100.0, oldmin * 100.0, (oldmax >= 0.040 || oldmin <= 0.005),
+            medmax * 100.0, medmin * 100.0, (medmax >= 0.040 || medmin <= 0.005),
+            pm * 100.0, pm >= 0.035
+        );
+        println!("QAFRONT old per-nation: {:?}", old.iter().map(|x| (x*10000.0).round()/100.0).collect::<Vec<_>>());
+        println!("QAFRONT new medians:    {:?}", meds.iter().map(|x| (x*10000.0).round()/100.0).collect::<Vec<_>>());
+    }
+
 }
 
 
