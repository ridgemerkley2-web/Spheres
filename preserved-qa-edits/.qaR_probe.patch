diff --git a/spheres-sim/src/lib.rs b/spheres-sim/src/lib.rs
index 8fd5057..ec7c0ee 100644
--- a/spheres-sim/src/lib.rs
+++ b/spheres-sim/src/lib.rs
@@ -2172,6 +2172,57 @@ mod tests {
         }
         assert!(born >= 6, "the union held together too often: {}/10", born);
     }
+    #[test]
+    #[ignore]
+    fn qa_sanction_cost_calibration() {
+        // Reconstruction of the table economy.rs cites as
+        // `sanction_cost_calibration`, which does not exist in the repo.
+        let target = NationId::China;
+        for (label, coalition) in [
+            ("USA alone", vec![NationId::USA]),
+            ("G5", vec![NationId::USA, NationId::UK, NationId::France, NationId::Germany, NationId::Japan]),
+        ] {
+            let mut control = world_1990(GameRules::default());
+            control.rules.ai_aggression = 0.0;
+            let c0 = control.nation(target).gdp;
+            run_months(&mut control, 240);
+            let base = exact::powf(control.nation(target).gdp / c0, 1.0 / 20.0) - 1.0;
+
+            let mut t = world_1990(GameRules::default());
+            t.rules.ai_aggression = 0.0;
+            let t0 = t.nation(target).gdp;
+            let mut share = 0.0;
+            for _ in 0..240 {
+                for i in &coalition {
+                    if !t.is_sanctioning(*i, target) { t.sanctions.push((*i, target)); }
+                }
+                share += t.sanction_weight(target);
+                tick_month(&mut t, &[]);
+            }
+            let after = exact::powf(t.nation(target).gdp / t0, 1.0 / 20.0) - 1.0;
+            println!(
+                "QASANC bite={:.3} {:9} share={:.3} base={:.3}% after={:.3}% lost={:.2}pt",
+                crate::world::qa_knob("QA_BITE", 0.020), label, share / 240.0,
+                base * 100.0, after * 100.0, (base - after) * 100.0
+            );
+        }
+    }
+
+    #[test]
+    #[ignore]
+    fn qa_poorest_margin() {
+        let mut worst = usize::MAX;
+        let mut vals: Vec<usize> = vec![];
+        for seed in 0..12u64 {
+            let mut w = world_1990(GameRules { seed, ..GameRules::default() });
+            run_months(&mut w, 360);
+            let m = w.nations.iter().filter(|n| n.alive).map(|n| n.tech.count()).min().unwrap();
+            vals.push(m);
+            if m < worst { worst = m; }
+        }
+        println!("QAPOOR poorest per seed {:?} worst {} (floor 5)", vals, worst);
+    }
+
 }
 
 
