diff --git a/spheres-sim/src/government.rs b/spheres-sim/src/government.rs
index 7458d92..13fa17a 100644
--- a/spheres-sim/src/government.rs
+++ b/spheres-sim/src/government.rs
@@ -3393,6 +3393,190 @@ pub const POLITIES: &[Polity] = &[
         ruling: "the House of Representatives",
         pillars: &[],
     },
+
+    // ===== The Horn and the Great Lakes (branch feat/r2-hornafrica) =========
+    //
+    // Five blocks and only two of them carry a competitive election, which is
+    // the honest shape of this neighbourhood in January 1990: Somalia, Rwanda
+    // and Eritrea have never held one to this day or did not hold one before
+    // the state that would have held it was destroyed, and Djibouti and Burundi
+    // held their first within three years of the game's start.
+
+    // Somalia — the Somali Revolutionary Socialist Party, sole legal party
+    // since its founding congress of 1 July 1976 and the only political
+    // organisation permitted in the country. The last election before the game
+    // opens was the People's Assembly poll of 31 December 1984, a single SRSP
+    // list on a yes/no ballot; its five-year term had therefore expired in
+    // December 1989 and was not renewed, which is why `next` is (0, 0) rather
+    // than a date. Somalia has never held a competitive national election, so
+    // unlike Ghana or Cameroon there is no later poll to borrow shares from,
+    // and the party sits at 1.00 in the shape ethiopia.json's block uses.
+    Polity {
+        nation: NationId::Somalia,
+        system: Electoral::FirstPastThePost,
+        term_months: 60,
+        next: (0, 0),
+        parties: &[
+            p("so_srsp", "Somali Revolutionary Socialist Party", "Xisbiga Hantiwadaagga Kacaanka Soomaaliyeed", Family::Communist, 1.00),
+        ],
+        ruling: "the Somali Revolutionary Socialist Party",
+        pillars: &[
+            // Named formations rather than "the army", per the rule this table
+            // sets itself, and in Somalia the distinction is the whole story.
+            // The Somali National Army was 47,000 men fragmenting along clan
+            // lines and going home unpaid; the Red Berets were Barre's
+            // Marehan-recruited presidential guard, commanded by his son
+            // Maslah, and they were the formation that still obeyed an order in
+            // January 1990. They were also what fired on the crowd at the
+            // Mogadishu stadium on 6 July 1990.
+            pl(Pillar::Army, "the Duub Cas"),
+            pl(Pillar::Security, "the National Security Service"),
+            pl(Pillar::Party, "the SRSP Central Committee"),
+        ],
+    },
+
+    // Djibouti — the Rassemblement Populaire pour le Progres, sole legal party
+    // by the law of October 1981 and the only list on the ballot at the
+    // National Assembly election of 24 April 1987, at which Hassan Gouled
+    // Aptidon was also returned unopposed as president. One party at 1.00, on
+    // the kenya.json and tanzania.json pattern.
+    //
+    // Djibouti DID hold a multi-party legislative election, on 18 December
+    // 1992 under the constitution of 4 September 1992, and it is not
+    // transcribed here on purpose. The RPP took 74.6% and all sixty-five
+    // seats against the Parti du Renouveau Democratique's 25.4% on a 48.5%
+    // turnout, with the other opposition and the Afar rebellion boycotting and
+    // a war on in the north. A result produced under those conditions is a
+    // worse description of Djiboutian opinion than the single-party fact this
+    // block records, which is the opposite of the situation in Ghana's and
+    // Burundi's blocks, where the first competitive vote was the real thing.
+    Polity {
+        nation: NationId::Djibouti,
+        system: Electoral::FirstPastThePost,
+        term_months: 60,
+        next: (0, 0),
+        parties: &[
+            p("dj_rpp", "Rassemblement Populaire pour le Progres", "Rassemblement Populaire pour le Progres", Family::BigTent, 1.00),
+        ],
+        ruling: "the Rassemblement Populaire pour le Progres",
+        pillars: &[
+            pl(Pillar::Party, "the RPP Political Bureau"),
+            pl(Pillar::Army, "the Armee Nationale Djiboutienne"),
+            pl(Pillar::Security, "the Service de Documentation et de Securite"),
+            // What actually kept Gouled in office was 3,800 French troops
+            // under the defence accords of 27 June 1977, and they are
+            // deliberately NOT a pillar. A pillar in this table is a domestic
+            // institution that could remove the government; a foreign garrison
+            // is a guarantee, which the model expresses as a relation and a
+            // patronage tie, and listing it here would let a player buy the
+            // loyalty of the French army with Djiboutian political capital.
+        ],
+    },
+
+    // Eritrea — a successor, so this block is unreachable until Asmara is
+    // actually on the board, exactly as the ten Soviet republics' blocks are.
+    // There has never been a national election in Eritrea. The Eritrean
+    // People's Liberation Front took Asmara on 24 May 1991, governed as the
+    // Provisional Government of Eritrea, ran the independence referendum of
+    // 23-25 April 1993 (99.83% yes on an 81% turnout — a referendum on
+    // statehood, not a contest between parties, so it is not transcribable as
+    // vote shares), and reconstituted itself as the People's Front for
+    // Democracy and Justice at its third congress in February 1994. The
+    // constitution ratified on 23 May 1997 has never been implemented and the
+    // elections due in 2001 have never been held. One party at 1.00 is not a
+    // simplification here; it is the complete description.
+    Polity {
+        nation: NationId::Eritrea,
+        system: Electoral::FirstPastThePost,
+        term_months: 60,
+        next: (0, 0),
+        parties: &[
+            p("er_pfdj", "People's Front for Democracy and Justice", "Hizbawi Ginbar nDimocrasin Fithin", Family::Nationalist, 1.00),
+        ],
+        ruling: "the People's Front for Democracy and Justice",
+        pillars: &[
+            pl(Pillar::Army, "the Eritrean Defence Forces"),
+            pl(Pillar::Party, "the PFDJ Central Council"),
+            pl(Pillar::Security, "the National Security Office"),
+        ],
+    },
+
+    // Rwanda — the Mouvement Revolutionnaire National pour le Developpement,
+    // sole legal party since 1975 and written into the constitution of 1978 as
+    // the movement every Rwandan belonged to from birth, with a cell structure
+    // that reached every hill. The last vote before the game opens is the
+    // presidential and legislative poll of 19 December 1988: Juvenal
+    // Habyarimana unopposed with 99.98%, and a single MRND list for the
+    // Conseil National de Developpement.
+    //
+    // No later competitive election is borrowed, and the reason is the
+    // saddest entry in this table. Rwanda legalised parties on 18 June 1991
+    // and the Arusha Accords of 4 August 1993 provided for elections at the
+    // end of a transition. The transition ended on 6 April 1994. The first
+    // national vote Rwanda ever held was in 2003, thirteen years past this
+    // start state and on the far side of the genocide, and importing that
+    // result would be importing the outcome. One party at 1.00.
+    Polity {
+        nation: NationId::Rwanda,
+        system: Electoral::FirstPastThePost,
+        term_months: 60,
+        next: (0, 0),
+        parties: &[
+            p("rw_mrnd", "Mouvement Revolutionnaire National pour le Developpement", "Muvoma Iharanira Amajyambere", Family::BigTent, 1.00),
+        ],
+        ruling: "the Mouvement Revolutionnaire National pour le Developpement",
+        pillars: &[
+            // The named-formation rule again, and Rwanda is as clear a case as
+            // Zaire. The Forces Armees Rwandaises were 5,000-odd men; the
+            // Garde Presidentielle was the French-trained battalion recruited
+            // from Habyarimana's own north-west, and it is the unit that
+            // mattered to whether he kept his office.
+            pl(Pillar::Army, "the Garde Presidentielle"),
+            pl(Pillar::Party, "the MRND Central Committee"),
+            pl(Pillar::Security, "the Service Central de Renseignements"),
+        ],
+    },
+
+    // Burundi — the Union pour le Progres National, sole legal party, with
+    // Pierre Buyoya governing through the Military Committee for National
+    // Salvation he had formed in the bloodless coup of 3 September 1987. There
+    // was no pre-1990 election to transcribe.
+    //
+    // The shares entered are the presidential election of 1 June 1993, the
+    // first competitive vote in Burundi's history and one of only two in this
+    // block: Melchior Ndadaye for the Front pour la Democratie au Burundi
+    // 65.68%, Buyoya for UPRONA 32.86%, Pierre-Claver Sendegeya for the Parti
+    // pour la Reconciliation du Peuple 1.46%. The legislative election four
+    // weeks later, on 29 June 1993, gave FRODEBU 72.58% and UPRONA 21.87%, so
+    // the presidential figures are the conservative reading of the same result.
+    // Unlike Djibouti's 1992 poll this one was genuinely contested, observed,
+    // and accepted by the loser: Buyoya conceded on the night. Ndadaye was
+    // sworn in on 10 July and murdered by the army on 21 October, which is a
+    // fact about the pillars below and not about the ballot.
+    // https://en.wikipedia.org/wiki/1993_Burundian_presidential_election
+    Polity {
+        nation: NationId::Burundi,
+        system: Electoral::FirstPastThePost,
+        term_months: 60,
+        next: (0, 0),
+        parties: &[
+            p("bi_frodebu", "Front pour la Democratie au Burundi", "Front pour la Democratie au Burundi", Family::SocialDemocratic, 0.6568),
+            p("bi_uprona", "Union pour le Progres National", "Union pour le Progres National", Family::BigTent, 0.3286),
+            p("bi_prp", "Parti pour la Reconciliation du Peuple", "Parti pour la Reconciliation du Peuple", Family::Conservative, 0.0146),
+        ],
+        ruling: "the Military Committee for National Salvation",
+        pillars: &[
+            // The one pillar in this block that is not a figure of speech. The
+            // Forces Armees Burundaises made governments in 1966, unmade one in
+            // 1976, unmade another in 1987, killed the president they had been
+            // told to protect in October 1993 and took the country back in July
+            // 1996. Twelve thousand men in a country of 5.6m, and the only
+            // institution in it that has never lost an argument.
+            pl(Pillar::Army, "the Forces Armees Burundaises"),
+            pl(Pillar::Party, "the UPRONA Central Committee"),
+            pl(Pillar::Security, "the Documentation Nationale"),
+        ],
+    },
 ];
 
