diff --git a/spheres-sim/src/government.rs b/spheres-sim/src/government.rs
index 7458d92..99bbc73 100644
--- a/spheres-sim/src/government.rs
+++ b/spheres-sim/src/government.rs
@@ -3393,6 +3393,457 @@ pub const POLITIES: &[Polity] = &[
         ruling: "the House of Representatives",
         pillars: &[],
     },
+
+    // ---- West Africa (branch feat/r2-westafrica2) -------------------------
+    // Eleven blocks, and ten of the eleven are regimes that held no contested
+    // election before January 1990 at all. Where that is so, this table follows
+    // the precedent Ghana and Cameroon set above and enters the FIRST FREE
+    // ELECTION AFTER THE GAME OPENS, saying so each time — a party table has to
+    // hold something, and a real later result is better evidence about who the
+    // political nation was than a single ruling party at 1.00 with nothing
+    // behind it. Two of the eleven need no such device: the Gambia was a working
+    // multi-party democracy and its 1987 result is transcribed straight, and
+    // Liberia had held an election in 1985 which was stolen and is entered as
+    // the stolen count it was.
+    //
+    // The dates in the comments are the dates. Nothing here schedules any of
+    // them: the model is free to arrive at a Malian coup in March 1991 or a
+    // Beninese national conference in February 1990 or neither.
+
+    // Mali — the Union Democratique du Peuple Malien, sole legal party since
+    // its founding congress of March 1979 and the civilian dress of the
+    // military government Moussa Traore had led since 19 November 1968. No
+    // legislature that could refuse him anything and no contested vote in
+    // twenty-one years. The shares are the National Assembly election of 23
+    // February and 8 March 1992, the first free one, held after Traore was
+    // overthrown on 26 March 1991 and after the national conference of July
+    // 1991: ADEMA-PASJ 48.4% and 76 of 129 seats, US-RDA 17.6%, CNID 5.6%,
+    // PDP 5.1%, RDP 4.4%, UDD 4.4%. Turnout was 21.3%, which is its own
+    // comment on what a national conference produces.
+    // https://en.wikipedia.org/wiki/1992_Malian_parliamentary_election
+    Polity {
+        nation: NationId::Mali,
+        system: Electoral::TwoRound,
+        term_months: 60,
+        next: (0, 0),
+        parties: &[
+            p("ml_adema", "Alliance for Democracy in Mali", "Alliance pour la Democratie au Mali - Parti Africain pour la Solidarite et la Justice", Family::SocialDemocratic, 0.484),
+            p("ml_usrda", "Sudanese Union - African Democratic Rally", "Union Soudanaise - Rassemblement Democratique Africain", Family::SocialDemocratic, 0.176),
+            p("ml_cnid", "National Congress for Democratic Initiative", "Congres National d'Initiative Democratique", Family::Liberal, 0.056),
+            p("ml_pdp", "Party for Democracy and Progress", "Parti pour la Democratie et le Progres", Family::SocialDemocratic, 0.051),
+            p("ml_rdp", "Rally for Democracy and Progress", "Rassemblement pour la Democratie et le Progres", Family::Liberal, 0.044),
+            p("ml_udd", "Union for Democracy and Development", "Union pour la Democratie et le Developpement", Family::Liberal, 0.044),
+        ],
+        ruling: "the Union Democratique du Peuple Malien",
+        pillars: &[
+            // Traore was a lieutenant when he took power and the army was the
+            // whole of his authority. It is also what removed him: Amadou
+            // Toumani Toure arrested him on 26 March 1991, four days after the
+            // army had shot something like 300 demonstrators in Bamako.
+            pl(Pillar::Army, "the Armee de Terre officer corps"),
+            pl(Pillar::Party, "the UDPM Central Executive Bureau"),
+            pl(Pillar::Security, "the Service de Securite d'Etat"),
+        ],
+    },
+
+    // Burkina Faso — the Popular Front, which is not a party but the junta
+    // Blaise Compaore formed on 15 October 1987 after Thomas Sankara was shot.
+    // No legislature, no election, and until April 1989 no party either; the
+    // Organisation pour la Democratie Populaire - Mouvement du Travail was
+    // built to be the Front's civilian face and had existed for eight months
+    // when the game opens. The shares are the National Assembly election of 24
+    // May 1992, the first multi-party vote: ODP-MT 48.5% and 78 of 107 seats,
+    // CNPP-PSD 12.0%, RDA 11.3%, ADF 8.7%, PAI 4.1%. Compaore had already taken
+    // the presidency unopposed on 1 December 1991 on a 25% turnout against an
+    // opposition boycott, which is why the presidential figure is not the one
+    // used here.
+    // https://en.wikipedia.org/wiki/1992_Burkinab%C3%A9_parliamentary_election
+    Polity {
+        nation: NationId::BurkinaFaso,
+        system: Electoral::Proportional,
+        term_months: 60,
+        next: (0, 0),
+        parties: &[
+            p("bf_odpmt", "Organisation for Popular Democracy - Labour Movement", "Organisation pour la Democratie Populaire - Mouvement du Travail", Family::BigTent, 0.485),
+            p("bf_cnppsd", "National Convention of Progressive Patriots - Social Democratic Party", "Convention Nationale des Patriotes Progressistes - Parti Social-Democrate", Family::SocialDemocratic, 0.120),
+            p("bf_rda", "African Democratic Rally", "Rassemblement Democratique Africain", Family::Conservative, 0.113),
+            p("bf_adf", "Alliance for Democracy and Federation", "Alliance pour la Democratie et la Federation", Family::Liberal, 0.087),
+            p("bf_pai", "African Independence Party", "Parti Africain de l'Independance", Family::Communist, 0.041),
+        ],
+        ruling: "the Popular Front",
+        pillars: &[
+            // The distinction this table insists on. What kept Compaore was not
+            // the army but the para-commando regiment at Po he had commanded
+            // himself, the nucleus of what became the Regiment de Securite
+            // Presidentielle — the formation that killed Sankara in 1987 and
+            // that mutinied and was disbanded in 2015, twenty-eight years and
+            // one presidency later.
+            pl(Pillar::Army, "the Po para-commando regiment"),
+            pl(Pillar::Party, "the Front Populaire coordinating committee"),
+            pl(Pillar::Security, "the Centre National de Documentation"),
+        ],
+    },
+
+    // Niger — the Mouvement National pour la Societe de Developpement, sole
+    // legal party under the constitution approved by referendum on 24 September
+    // 1989, and the civilianisation of the Conseil Militaire Supreme that had
+    // governed since Seyni Kountche's coup of 15 April 1974. Ali Saibou was
+    // elected president unopposed on 10 December 1989 on a single MNSD list —
+    // THREE WEEKS BEFORE THE GAME OPENS — which is a real election with a real
+    // date and no choice in it, so it is not the one entered. The shares are
+    // the National Assembly election of 14 February 1993, the first multi-party
+    // vote: MNSD-Nassara 30.7% and 29 of 83 seats, CDS-Rahama 27.3%,
+    // ANDP-Zaman Lahiya 15.5%, PNDS-Tarayya 14.6%. The MNSD won the most seats
+    // and lost the government, because the other eight parties formed the
+    // Alliance des Forces du Changement and took 50 seats between them — which
+    // is the outcome this table's seat formula exists to be able to produce.
+    // https://en.wikipedia.org/wiki/1993_Nigerien_parliamentary_election
+    Polity {
+        nation: NationId::Niger,
+        system: Electoral::Proportional,
+        term_months: 60,
+        next: (0, 0),
+        parties: &[
+            p("ne_mnsd", "National Movement for the Society of Development", "Mouvement National pour la Societe de Developpement - Nassara", Family::BigTent, 0.307),
+            p("ne_cds", "Democratic and Social Convention", "Convention Democratique et Sociale - Rahama", Family::Liberal, 0.273),
+            p("ne_andp", "Nigerien Alliance for Democracy and Progress", "Alliance Nigerienne pour la Democratie et le Progres - Zaman Lahiya", Family::SocialDemocratic, 0.155),
+            p("ne_pnds", "Nigerien Party for Democracy and Socialism", "Parti Nigerien pour la Democratie et le Socialisme - Tarayya", Family::SocialDemocratic, 0.146),
+            p("ne_sawaba", "Sawaba", "Union Democratique Nigerienne - Sawaba", Family::Communist, 0.031),
+            p("ne_ppnrda", "Nigerien Progressive Party - African Democratic Rally", "Parti Progressiste Nigerien - Rassemblement Democratique Africain", Family::Conservative, 0.026),
+        ],
+        ruling: "the Mouvement National pour la Societe de Developpement",
+        pillars: &[
+            pl(Pillar::Army, "the Forces Armees Nigeriennes"),
+            pl(Pillar::Party, "the MNSD Bureau Executif National"),
+            // The gendarmerie rather than a secret police, because in Niger it
+            // was the gendarmerie that did the regime's internal work — at the
+            // Kennedy bridge in Niamey on 9 February 1990 and at Tchintabaraden
+            // three months later.
+            pl(Pillar::Security, "the Gendarmerie Nationale"),
+        ],
+    },
+
+    // Guinea — the Comite Militaire de Redressement National, and this is the
+    // barest block in the table because there was nothing else. Lansana Conte's
+    // officers took power on 3 April 1984, a week after Sekou Toure died; the
+    // Parti Democratique de Guinee that had ruled since 1958 was abolished
+    // outright rather than inherited, all parties were banned, there was no
+    // legislature, and Guinea in January 1990 had never held a contested
+    // election of any kind since independence. The shares are the presidential
+    // election of 19 December 1993, the first: Conte for the newly built Parti
+    // de l'Unite et du Progres 51.7% — just over the threshold that avoided a
+    // runoff, on a count the opposition rejected — Alpha Conde 19.6%, Mamadou
+    // Boye Ba 13.4%, Siradiou Diallo 11.9%.
+    // https://en.wikipedia.org/wiki/1993_Guinean_presidential_election
+    Polity {
+        nation: NationId::Guinea,
+        system: Electoral::TwoRound,
+        term_months: 60,
+        next: (0, 0),
+        parties: &[
+            p("gn_pup", "Party of Unity and Progress", "Parti de l'Unite et du Progres", Family::BigTent, 0.517),
+            p("gn_rpg", "Rally of the Guinean People", "Rassemblement du Peuple de Guinee", Family::SocialDemocratic, 0.196),
+            p("gn_unr", "Union for the New Republic", "Union pour la Nouvelle Republique", Family::Liberal, 0.134),
+            p("gn_prp", "Party for Renewal and Progress", "Parti du Renouveau et du Progres", Family::Liberal, 0.119),
+        ],
+        ruling: "the Comite Militaire de Redressement National",
+        pillars: &[
+            // Diarra Traore's counter-coup of 4 July 1985 is what defines the
+            // shape of this regime: it failed, and Conte answered by having the
+            // officers involved killed and by rebuilding the guard around men
+            // from his own Soussou coast.
+            pl(Pillar::Army, "the presidential guard"),
+            pl(Pillar::Security, "the Service de Securite Presidentielle"),
+        ],
+    },
+
+    // Benin — the Parti de la Revolution Populaire du Benin, sole legal party
+    // of a self-declared Marxist-Leninist state since 1975, and on 1 January
+    // 1990 a party that had abandoned Marxism-Leninism twenty-five days
+    // earlier and had no money to pay anybody. The shares are the National
+    // Assembly election of 17 February 1991, the first free one and the one
+    // that followed the national conference of 19-28 February 1990 —
+    // SEVEN WEEKS INTO THE GAME — at which 488 delegates declared themselves
+    // sovereign and took the government away from Mathieu Kerekou without a
+    // shot. What the 1991 result shows is what a state with no parties for
+    // fifteen years produces when it suddenly has them: twelve lists, none
+    // above 19%, and a national assembly that is a negotiation. UTRD 18.9%,
+    // RND 12.1%, PRD-PNDD 11.7%, NCC 10.1%, PSD-UNSP 9.8%, MNDD 8.4%, UDES
+    // 7.1%, RDL-Vivoten 5.6%. Kerekou then lost the presidency to Nicephore
+    // Soglo in March 1991, conceded, and won it back at the ballot in 1996.
+    // https://en.wikipedia.org/wiki/1991_Beninese_parliamentary_election
+    Polity {
+        nation: NationId::Benin,
+        system: Electoral::Proportional,
+        term_months: 48,
+        next: (0, 0),
+        parties: &[
+            p("bj_utrd", "Union for the Triumph of Democratic Renewal", "Union pour le Triomphe du Renouveau Democratique", Family::BigTent, 0.189),
+            p("bj_rnd", "National Rally for Democracy", "Rassemblement National pour la Democratie", Family::Liberal, 0.121),
+            p("bj_prd", "Party of Democratic Renewal", "Parti du Renouveau Democratique", Family::SocialDemocratic, 0.117),
+            p("bj_ncc", "Our Common Cause", "Notre Cause Commune", Family::SocialDemocratic, 0.101),
+            p("bj_psd", "Social Democratic Party", "Parti Social-Democrate", Family::SocialDemocratic, 0.098),
+            p("bj_mndd", "Democratic Renewal Movement", "Mouvement National pour la Democratie et le Developpement", Family::SocialDemocratic, 0.084),
+            p("bj_udes", "Union for Democracy and National Solidarity", "Union pour la Democratie et la Solidarite Nationale", Family::Liberal, 0.071),
+            p("bj_rdl", "Liberal Democratic Rally", "Rassemblement des Democrates Liberaux - Vivoten", Family::Liberal, 0.056),
+        ],
+        ruling: "the Parti de la Revolution Populaire du Benin",
+        pillars: &[
+            // Listed, and the block's point is that all three had stopped
+            // working. The army had not been paid, the party had renounced its
+            // own doctrine, and when the national conference declared itself
+            // sovereign in February 1990 not one of them moved to stop it.
+            pl(Pillar::Army, "the Forces Armees Populaires du Benin"),
+            pl(Pillar::Party, "the PRPB Central Committee"),
+            pl(Pillar::Security, "the Direction de la Surete Nationale"),
+        ],
+    },
+
+    // Togo — the Rassemblement du Peuple Togolais, sole legal party since 1969
+    // and the instrument of Gnassingbe Eyadema, who had shot Sylvanus Olympio
+    // himself in January 1963 and taken the presidency in January 1967. The
+    // shares here are SEAT SHARES AND NOT VOTE SHARES, and that is stated
+    // rather than hidden: the National Assembly election of 6 February and 20
+    // March 1994, the first multi-party vote, returned CAR 36, RPT 35, UTD 7,
+    // UJD 2 and CFN 1 of 81 seats on a 65.1% turnout, and the published
+    // national vote shares for it were not reachable when this file was
+    // written. Seats are entered as a proportion of 81. It is a substitution
+    // and it is the weakest transcription in this block. The finding it carries
+    // is right and is the reason the block is here at all: the party that had
+    // governed Togo unopposed for twenty-five years came SECOND the first time
+    // anybody was allowed to vote against it, and then kept the government
+    // anyway, because Eyadema had the army and the Action Committee for Renewal
+    // did not. He died in office in February 2005.
+    // https://en.wikipedia.org/wiki/1994_Togolese_parliamentary_election
+    Polity {
+        nation: NationId::Togo,
+        system: Electoral::TwoRound,
+        term_months: 60,
+        next: (0, 0),
+        parties: &[
+            p("tg_car", "Action Committee for Renewal", "Comite d'Action pour le Renouveau", Family::Liberal, 0.444),
+            p("tg_rpt", "Rally of the Togolese People", "Rassemblement du Peuple Togolais", Family::BigTent, 0.432),
+            p("tg_utd", "Togolese Union for Democracy", "Union Togolaise pour la Democratie", Family::Liberal, 0.086),
+            p("tg_ujd", "Union for Justice and Democracy", "Union pour la Justice et la Democratie", Family::Conservative, 0.025),
+            p("tg_cfn", "Coordination of New Forces", "Coordination des Forces Nouvelles", Family::Liberal, 0.012),
+        ],
+        ruling: "the Rassemblement du Peuple Togolais",
+        pillars: &[
+            // Recruited from Eyadema's own Kabye in the north and garrisoned on
+            // top of an Ewe capital that did not want him. This is why the
+            // national conference of July-August 1991 stripped him of power and
+            // he still had it three months later.
+            pl(Pillar::Army, "the Regiment Interarmes Togolais"),
+            pl(Pillar::Party, "the RPT Political Bureau"),
+            pl(Pillar::Security, "the Gendarmerie Nationale"),
+        ],
+    },
+
+    // Sierra Leone — the All People's Congress, sole legal party under the
+    // one-party constitution of June 1978, and Joseph Saidu Momoh, who had
+    // succeeded Siaka Stevens in 1985 as the only candidate on the ballot. The
+    // last election before the game opens was the single-party parliamentary
+    // vote of 29 May 1986, in which the APC vetted every candidate. The shares
+    // are the parliamentary election of 26-27 February 1996, held under a
+    // military government that had promised to hand over and then did, in the
+    // middle of a civil war and after the APC had been out of power for four
+    // years: SLPP 36.2% and 27 of 68 elected seats, UNPP 22.1%, PDP 15.3%,
+    // APC 5.7%, NUP 5.3%, DCP 4.8%. THE PARTY THAT RULED SIERRA LEONE FOR
+    // TWENTY-THREE YEARS TOOK 5.7% THE FIRST TIME IT HAD TO ASK, which is as
