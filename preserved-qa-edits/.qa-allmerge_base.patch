+#[cfg(test)]
+mod zzp2 {
+    use super::*;
+    use crate::init::world_1990;
+
+    #[test]
+    fn zz_frontier_clock() {
+        println!("ZZ2 registry_size={}", crate::tech::registry().len());
+        let mut w = world_1990(GameRules::default());
+        for m in 1..=360 {
+            tick_month(&mut w, &[]);
+            if m % 60 == 0 {
+                let front = w.nations.iter().filter(|n| n.alive).map(|n| n.tech.count()).max().unwrap_or(0);
+                let med: f64 = {
+                    let mut v: Vec<usize> = w.nations.iter().filter(|n| n.alive).map(|n| n.tech.count()).collect();
+                    v.sort();
+                    v[v.len()/2] as f64
+                };
+                let wgdp: f64 = w.nations.iter().filter(|n| n.alive).map(|n| n.gdp).sum();
+                println!("ZZ2 month={} frontier={} median_techs={} china={} usa={} world_gdp={:.0}",
+                    m, front, med, w.nation(NationId::China).tech.count(), w.nation(NationId::USA).tech.count(), wgdp);
+            }
+        }
+    }
+
+    #[test]
+    fn zz_relations_matrix() {
+        let mut w = world_1990(GameRules::default());
+        let n = w.nations.len();
+        println!("ZZ2 rel nations={} expect_tri={}", n, n * (n + 1) / 2);
+        // round-trip the highest-index pair
+        let a = w.nations[n - 1].id;
+        let b = w.nations[n - 2].id;
+        let before = w.relation(a, b);
+        w.relations.set(a, b, -73.5);
+        let got = w.relation(a, b);
+        let sym = w.relation(b, a);
+        println!("ZZ2 rel high_pair {:?}/{:?} before={:.2} set=-73.5 got={:.2} sym={:.2}", a, b, before, got, sym);
+        // count distinct nonzero dyads and check no aliasing: set every pair to its index and read back
+        let ids: Vec<NationId> = w.nations.iter().map(|x| x.id).collect();
+        let mut k = 0.0f64;
+        for i in 0..ids.len() { for j in (i + 1)..ids.len() { k += 1.0; w.relations.set(ids[i], ids[j], k % 97.0 - 48.0); } }
+        let mut k2 = 0.0f64; let mut bad = 0;
+        for i in 0..ids.len() { for j in (i + 1)..ids.len() {
+            k2 += 1.0;
+            if (w.relation(ids[i], ids[j]) - (k2 % 97.0 - 48.0)).abs() > 1e-12 { bad += 1; }
+        } }
+        println!("ZZ2 rel aliasing_failures={} of {}", bad, (ids.len() * (ids.len() - 1)) / 2);
+    }
+}
