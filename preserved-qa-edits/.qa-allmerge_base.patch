+#[cfg(test)]
+mod zzfrontier {
+    use super::*;
+    use crate::init::world_1990;
+
+    #[test]
+    fn zz_frontier_seeds() {
+        let mature = [NationId::USA, NationId::Japan, NationId::Germany,
+                      NationId::France, NationId::UK, NationId::Italy];
+        for seed in 0..6u64 {
+            let start: Vec<(NationId, f64)> = {
+                let w = world_1990(GameRules { seed, ..GameRules::default() });
+                mature.iter().map(|id| (*id, w.nation(*id).gdp)).collect()
+            };
+            let mut w = world_1990(GameRules { seed, ..GameRules::default() });
+            for _ in 0..(12 * 35) { tick_month(&mut w, &[]); }
+            let mut line = format!("ZZF seed={} ", seed);
+            let mut hot = 0; let mut cold = 0;
+            for (id, g0) in start {
+                let n = w.nation(id);
+                let cagr = exact::powf(n.gdp / g0, 1.0 / 35.0) - 1.0;
+                if cagr >= 0.040 { hot += 1; }
+                if cagr <= 0.005 { cold += 1; }
+                line.push_str(&format!("{:?}={:.3}% ", id, cagr * 100.0));
+            }
+            let trades = w.statecraft.trade.len();
+            let usa_trades = w.statecraft.trade.iter().filter(|t| format!("{:?}", t).contains("USA")).count();
+            let uk_trades = w.statecraft.trade.iter().filter(|t| format!("{:?}", t).contains("UK")).count();
+            println!("{} | hot={} cold={} trades={} usa_t={} uk_t={} pacts={} sanc={}",
+                line, hot, cold, trades, usa_trades, uk_trades, w.statecraft.pacts.len(), w.sanctions.len());
+        }
+    }
