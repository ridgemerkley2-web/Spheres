+    #[test]
+    fn zz_china_history() {
+        let mut tw = 0.0; let mut ts = 0.0; let mut tx = 0.0;
+        for seed in 0..10u64 {
+            let mut w = world_1990(GameRules { seed, ..GameRules::default() });
+            let s = w.nation(NationId::China).gdp;
+            let mut war_months = 0; let mut sanc_months = 0.0;
+            for _ in 0..360 {
+                tick_month(&mut w, &[]);
+                if w.at_war(NationId::China) { war_months += 1; }
+                sanc_months += w.sanctioned_by_count(NationId::China) as f64;
+            }
+            let x = w.nation(NationId::China).gdp / s;
+            println!("ZZ3 china seed={} x={:.3} war_months={} sanction_month_pairs={:.0}", seed, x, war_months, sanc_months);
+            tw += war_months as f64; ts += sanc_months; tx += x;
+        }
+        println!("ZZ3 china TOTALS mean_x={:.3} mean_war_months={:.1} mean_sanction_pairs={:.1}", tx/10.0, tw/10.0, ts/10.0);
+    }
