+
+pub fn qa_knob(name: &str, default: f64) -> f64 {
+    use std::collections::HashMap;
+    use std::sync::OnceLock;
+    static M: OnceLock<HashMap<String, f64>> = OnceLock::new();
+    let m = M.get_or_init(|| {
+        std::env::vars().filter(|(k, _)| k.starts_with("QA_"))
+            .filter_map(|(k, v)| v.parse::<f64>().ok().map(|x| (k, x))).collect()
+    });
+    *m.get(name).unwrap_or(&default)
+}
